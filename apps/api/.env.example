# ============================================================================
#  قالب ملف الأسرار — انسخه إلى  .env  في نفس المجلد واملأ القيم
# ============================================================================
#
#  ⚠️ ملف `.env` نفسه **مستثنى من Git** — لا تُرفع الأسرار أبدًا.
#  ⚠️ لا تكتب أي مفتاح أو كلمة سر داخل الكود مباشرة.
#
#  الأولوية: متغيّرات البيئة الحقيقية > .env > appsettings*.json
#
# ============================================================================

# ---------- التشغيل ----------
# الإنتاج دائمًا Production: بيئة Development تُفعّل SQLite وEnsureCreated.
ASPNETCORE_ENVIRONMENT=Production
# ⚠️ بلا هذا السطر يرجع Kestrel إلى منفذه الافتراضي 5000، فكل نداء على 5279 يردّ 000 ويظهر
#    كأن الـ API مات — مقيس. `dotnet run --launch-profile http` يعطي المنفذ من launchSettings،
#    أما تشغيل الـ dll مباشرة (deploy/edulink-api.service) فيحتاجه من هنا.
# 127.0.0.1 لا 0.0.0.0: الـ API لا يسمع من العامة إطلاقًا — nginx (/edulink/api) هو المدخل الوحيد.
ASPNETCORE_URLS=http://127.0.0.1:5279

# ---------- قاعدة البيانات ----------
# الشكل المُسلَّم: **SqlServer** على سيرفر العميل. وPostgres (Supabase) يبقى مدعومًا
# بنفس الكود — الدليل docs/10-supabase-connection.md. وSqlite للتطوير المحلي وحده.
Database__Provider=SqlServer

# على SqlServer/Postgres يجب أن تبقى false: المخطط من database/schema.sql فقط.
# خارج Development يرفض الـ API الإقلاع بخروج 1 على EnsureCreated=true (مقيس — الخطوة 51).
Database__EnsureCreated=false

# ---------- SQL Server: المخطط من ملف واحد يعمل Run ----------
# `RUN-ON-SQL-SERVER.sql` في جذر المستودع (قسم T-SQL من database/schema.sql، مُستخرَج ولا
# يُحرَّر يدويًا — أمر التوليد في apps/api/README.md). يُنشئ القاعدة `EdulinkDb` والجداول:
#   sqlcmd -S "SERVER,1433" -U sa -P "PASSWORD" -f 65001 -I -b -i RUN-ON-SQL-SERVER.sql
# الأعلام ليست ترفًا: `-I` لأن على جداول Edu_ فهارس مفلترة ترفض QUOTED_IDENTIFIER OFF
# (Msg 1934 على أي INSERT/DELETE يدوي)، و`-f 65001` للعربية وإلا حُفظت `?`، و`-b` حتى لا
# يمشي الخطأ بصمت. الملف تراكمي: مرة أو عشر مرات بنفس النتيجة.
# مقيس (2026-10-21) على SQL Server حقيقي: تشغيلان متتاليان للملف حرفيًا بخروج **0/0** والبصمة
# 11 جدولًا · صفر تريجر · 21 فحصًا · 9 مفاتيح خارجية · 43 قيمة افتراضية · 8 تفريد · 104 أعمدة.
#
# صيغة اسم السيرفر: SERVER,1433 (فاصلة لا نقطتين) أو SERVER\INSTANCE للتسمية المحلية.
#
# ⚠️ **التشفير — مُقاس (2026-10-18) على سيرفر الاستضافة المشتركة `nile-server.com,1433`:**
#    `Encrypt=True;TrustServerCertificate=True` يقبل المصافحة ويصل إلى التحقق من الدخول (الفشل
#    الوحيد كان `18456 Login failed for user 'sa'` أي كلمة السر)، فالـ API **لا** يحتاج إطفاء
#    التشفير مع هذا السيرفر. لكن:
#      · `TrustServerCertificate=True` = تشفير **بلا تحقّق من هوية السيرفر** (محمي من القراءة،
#        لا من الانتحال) — مقبول مؤقتًا على شهادة ذاتية، لا عند التسليم النهائي.
#      · اللوج يطبع «negotiated TLS 1.0 is an insecure protocol»: اطلب من صاحب السيرفر تفعيل
#        **TLS 1.2** + شهادة موثوقة، ثم حوّل إلى `Encrypt=True;TrustServerCertificate=False`.
#      · `Encrypt=False` والقاعدة تعبر الإنترنت **مرفوض** كخيار تسليم (اسم المستخدم وكل صف بلا
#        تشفير). لا يضيف الكود أيًّا من هذه الأعلام صمتًا — الترخيص الأمني قرار إنسان.
#
# الحساب: ملف المخطط **لا** يُنشئ Login. الأحسن حساب باسم `edulink` بصلاحيات قاعدته وحده
# لا `sa` (الخطوة مكتوبة في docs/06-deployment.md §«حساب دخول للمنصة لا sa»).
ConnectionStrings__SqlServer=Server=YOUR-SERVER,1433;Database=EdulinkDb;User ID=edulink;Password=[YOUR-PASSWORD];Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30

# ---------- البديل: Supabase / Postgres ----------
# Connect → Session pooler (Shared) → Connection string → URI، واستبدل [YOUR-PASSWORD].
# استخدم Session pooler (المنفذ 5432) لا Direct connection: المباشر يعمل على IPv6 فقط.
# الصيغة مزدوجة الأسطر المئوية (%) تُترك كما هي — الكود يفكّها تلقائيًا.
#Database__Provider=Postgres
#ConnectionStrings__Postgres=postgresql://postgres.PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- أصل الواجهة (CORS) ----------
# على السيرفر الواجهة والـ API **نفس الأصل** تحت بادئة واحدة (`/edulink`) كما في
# deploy/nginx-edulink.conf: لا طلب عابر للأصل يحدث إطلاقًا، فلا تُفعّل أي `Cors__Origins`.
# مقيس (2026-10-21) بالبناء الإنتاجي نفسه في متصفح حقيقي: `/edulink/api/auth/login` ثم
# `/edulink/api/{sessions,students,users,parents,reports/overview}` كلها 200، وترقية
# WebSocket على `/edulink/hubs/meetings` تعمل — بلا أي استثناء CORS.
# تُفعّلها فقط لو خُدمت الواجهة على **أصل آخر** (دومين المؤسسة مثلًا): القيمة بروتوكول +
# نطاق فقط، بلا شرطة مائلة نهائية وبلا مسار، و**لا نجمة `*`** لأن الدخول يحمل توكنًا.
# (في التطوير تُقرأ localhost:5173/5174 من appsettings.json — لا تكتبها هنا فتبقى مفتوحة
#  على أصل لا تخدمه.)
#Cors__Origins__0=https://YOUR-DOMAIN            # دومين المؤسسة (white-label)

# ---------- وسيط أمامي (nginx) وعنوان العميل الحقيقي ----------
# ⚠️ خلف nginx بدون هذا التفعيل يبقى RemoteIpAddress = عنوان الحاوية لكل الزوار:
#    مدرسة كاملة تُحسب عميلًا واحدًا عند حدّ الدخول، وتُرفض كل طلباتها بـ 429.
Network__UseForwardedHeaders=true
#   عدد الوسائط المأمونة **أمام** الـ API (القيمة الافتراضية 1 وهي الصحيحة لنشر deploy/nginx.conf):
#     1 = nginx وحده يضيف القيمة الأخيرة، وأقدم قيمة يزيّفها العميل فتُتجاهل ⇒ حدّ الدخول يسري على IP العميل الحقيقي.
#     2 = فقط لو كان أمام nginx وسيط آخر (Cloudflare/CDN) يضيف قيمته.
#   ⚠️ رفع هذا الرقم بلا حاجة يفجر الحماية: مقيس محليًا — حدّ 4 مع 130 محاولة لكل واحدة
#      X-Forwarded-For مزوَّر مختلف ⇒ **صفر** 429 (كل محاولة حزنة جديدة)؛ حدّ 1 ⇒ 429 عند المحاولة 121.
Network__ForwardedHeadersLimit=1
#   أفضل تحديد: شبكة/عنوان الوسيط المعروف (يُقبل الترويسة منه فقط):
#Network__TrustedProxies__0=127.0.0.1
#Network__TrustedNetworks__0=172.18.0.0/16
#   TrustAllProxies=true آمنة **فقط** حين لا منفذ مكشوف للـ API (nginx المدخل الوحيد كما في deploy):
Network__TrustAllProxies=true

# ---------- تحديد معدل الطلبات ----------
# Login: لكل IP · Api: لكل جلسة (Bearer) · Hub: لكل جهاز (توكن الغرفة) · قفل الدخول: لكل حساب.
RateLimit__LoginPermitPerMinute=120
RateLimit__ApiPermitPerMinute=600
RateLimit__HubPermitPerMinute=3000
# قفل **لكل حساب**: بعد هذا العدد من المحاولات الفاشلة داخل المدة يُرفض الدخول بـ 429
# (يرفض حتى الكلمة الصحيحة أثناء القفل، ويصفّر العدّاد عند أي دخول ناجح).
RateLimit__LoginFailuresPerAccount=8
RateLimit__LoginLockoutMinutes=5

# ---------- WebRTC (الغرفة اللايف) ----------
# TURN إجباري قبل الإنتاج: شبكات NAT الصارمة تفصل الاتصال بلا خادم وسيط.
# TurnSecret = نفس use-auth-secret في coturn — التوكيانات تُوقّع لكل مستخدم وتنتهي بعد TurnTtlSeconds.
# على هذا السيرفر (بلا Docker): coturn يُنصَب ويُخدم كعملية مستقلة بنفس إعداد
# deploy/turnserver.conf، ويحتاج منفذ 3478 ومدى بوابات UDP للوسائط (49160-49200 هناك) مفتوحة في
# جدار النار. مثال الحاوية في deploy/docker-compose.yml يبقى صالحًا لعربة Docker.
# لا تعتمد على تطابق السرّ يدويًا: `deploy/run.sh` يقاطعه مع static-auth-secret في deploy/turnserver.conf،
# و`python tools/verify-ice-turn.py green` يعيد حساب التوقيع ويتأكد أن عمره يساوي TTL أدناه.
# اجعل TTL أطول من مدة الحصة — توكن ينتهي أثناء حصة حيّة يقطع الوسائط عند أول NAT صارم.
# ⚠️ لا تترك سطر TurnUrls **فارغ القيمة**: `Meeting__TurnUrls__0=` يُدخل `{"urls":[""]}`
#    في إعداد ICE المُرسَل للمتصفح (كُشف بالقياس في الخطوة 50). علّق السطر بـ `#` لا تحذف قيمته.
Meeting__TurnUrls__0=turn:YOUR-DOMAIN:3478?transport=udp
Meeting__TurnUrls__1=turns:YOUR-DOMAIN:5349?transport=tcp
Meeting__TurnSecret=
Meeting__TurnTtlSeconds=86400
