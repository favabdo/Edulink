{
  "name": "eduspace",
  "private": true,
  "version": "0.0.0",
  "description": "EduLink — منصة تعليمية أونلاين (monorepo)",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @eduspace/web",
    "build": "npm run build --workspace @eduspace/web",
    "lint": "npm run lint --workspace @eduspace/web",
    "preview": "npm run preview --workspace @eduspace/web"
  }
}
